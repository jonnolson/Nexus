{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "version": "0.1.0",
  "identifier": "app.nexus.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm --filter web dev",
      "cwd": "../../..",
      "wait": false
    },
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://nexus.example.com"
  },
  "app": {
    "windows": [
      {
        "title": "Nexus",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
