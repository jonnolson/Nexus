# Copy to .env.local (never commit .env.local).
# Local values are printed by `pnpm db:start` (run from the repo root).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Emailing invoices (optional; server-only, never NEXT_PUBLIC_). Get a key at resend.com
# and verify your sending domain there. Without these, "Email invoice" stays disabled.
# RESEND_API_KEY=re_xxxxxxxx
# INVOICE_FROM_EMAIL="Your Studio <billing@yourstudio.ca>"

# Set to false for password-only sign-in (no authenticator step). Works locally and in
# production; leave unset to require MFA.
# NEXUS_MFA_REQUIRED=false
